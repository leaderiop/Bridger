{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@bridger/kit/sdk": [
        "./src/sdk.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "bin"
  ],
  "exclude": [
    "test/foldkit-runtime.test.ts"
  ]
}
